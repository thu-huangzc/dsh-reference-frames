{
  "name": "dsh-reference-frames",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "description": "Reference Frames — search real animation frames from a free-form brief (text or image), then collect the ones that land into moodboards.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "styles.json",
    "README.md",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  }
}
