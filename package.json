{
  "name": "dsh-reference-frames",
  "version": "1.5.0",
  "private": true,
  "type": "module",
  "description": "Reference Frames — search real reference frames (animation, film stills, commercials, web) from a free-form brief (text or image), then collect the ones that land into moodboards.",
  "author": "thu-huangzc (https://github.com/thu-huangzc)",
  "contributors": [
    {
      "name": "DeepSeek",
      "url": "https://github.com/deepseek-ai"
    }
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "README.md",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "presets/moodboards.json"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  }
}
